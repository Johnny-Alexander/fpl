# Copy to .env and fill in. .env is gitignored -- never commit real credentials.
#
# Outlook/Hotmail requires an APP PASSWORD, not your account password.
# Generate one at https://account.microsoft.com/security (2FA must be on first).

FPL_SMTP_USER=johnnyalexander@hotmail.co.uk
FPL_SMTP_PASSWORD=your-app-password-here
FPL_EMAIL_TO=johnnyalexander@hotmail.co.uk

# Defaults, override only if your provider differs.
FPL_SMTP_HOST=smtp-mail.outlook.com
FPL_SMTP_PORT=587
